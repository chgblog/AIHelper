<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AIHelper.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIHelper\AIHelper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window XAML uses Icon="/icon.ico", which resolves against the entry assembly -->
    <Resource Include="..\AIHelper\icon.ico" Link="icon.ico" />
  </ItemGroup>
</Project>
