<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AIHelper</RootNamespace>
    <AssemblyName>AIHelper</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Title>AIHelper</Title>
    <Authors>chgblog</Authors>
    <Version>0.6.7</Version>
    <Company>chgblog</Company>
    <Product>AIHelper</Product>
    <PackageProjectUrl>https://github.com/chgblog/AIHelper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chgblog/AIHelper</RepositoryUrl>
    <Copyright>Copyright (C) 2026 chgblog</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
    <PackageReference Include="Costura.Fody" Version="5.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\injector.js" />
    <EmbeddedResource Include="Assets\element-picker.js" />
  </ItemGroup>

</Project>
