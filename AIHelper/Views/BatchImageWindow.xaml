<Window x:Class="AIHelper.Views.BatchImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:AIHelper.Services"
        Title="{Binding [Batch_Title], Source={x:Static services:LanguageManager.Instance}}"
        Height="660" Width="940" MinHeight="480" MinWidth="700" Icon="/icon.ico"
        WindowStartupLocation="CenterOwner" Background="#1a1a2e" Foreground="#e0e0e0"
        WindowStyle="ToolWindow">
    <Window.Resources>
        <Style x:Key="PresetButton" TargetType="Button">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Background" Value="#3a3a5e"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CSV 文件 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [Batch_CsvFile], Source={x:Static services:LanguageManager.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="txtCsvPath" Grid.Column="1" IsReadOnly="True" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" Padding="5,3"/>
            <Button x:Name="btnPickCsv" Grid.Column="2" Content="{Binding [Batch_PickCsv], Source={x:Static services:LanguageManager.Instance}}" Click="BtnPickCsv_Click"
                    Margin="8,0,0,0" Padding="12,4" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <!-- 概要信息 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="tbDefaultPlatform" Foreground="#a0a0b0" FontSize="12"/>
            <TextBlock x:Name="tbOutputDir" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
            <TextBlock x:Name="tbSummary" Foreground="#a0a0b0" FontSize="12" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding [Batch_Tip], Source={x:Static services:LanguageManager.Instance}}" Foreground="#f0a050" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 页面预设：每次新建对话后重放的模型、比例等选择，以及是否点开大图再保存 -->
        <Border Grid.Row="2" Background="#202036" BorderBrush="#3a3a5e" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [Batch_Preset_Title], Source={x:Static services:LanguageManager.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbPresetPlatform" Grid.Column="1" DisplayMemberPath="Name" VerticalAlignment="Center" SelectionChanged="CmbPresetPlatform_SelectionChanged"/>
                    <CheckBox x:Name="chkOpenLarge" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#e0e0e0"
                              Content="{Binding [Batch_Preset_OpenLarge], Source={x:Static services:LanguageManager.Instance}}"
                              ToolTip="{Binding [Batch_Preset_OpenLargeTip], Source={x:Static services:LanguageManager.Instance}}"
                              Click="ChkOpenLarge_Click"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button x:Name="btnPresetRecord" Style="{StaticResource PresetButton}" Background="#7c3aed" Foreground="White" Click="BtnPresetRecord_Click"/>
                        <Button x:Name="btnPresetCancel" Style="{StaticResource PresetButton}" Visibility="Collapsed" Click="BtnPresetCancel_Click"
                                Content="{Binding [Batch_Preset_Cancel], Source={x:Static services:LanguageManager.Instance}}"/>
                        <Button x:Name="btnPresetTest" Style="{StaticResource PresetButton}" Click="BtnPresetTest_Click"
                                Content="{Binding [Batch_Preset_Test], Source={x:Static services:LanguageManager.Instance}}"/>
                        <Button x:Name="btnPresetClear" Style="{StaticResource PresetButton}" Click="BtnPresetClear_Click"
                                Content="{Binding [Batch_Preset_Clear], Source={x:Static services:LanguageManager.Instance}}"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="tbPresetInfo" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="icPresetSteps" Margin="0,2,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2a2a3e" CornerRadius="10" Padding="8,1,2,1" Margin="0,2,6,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Display}" ToolTip="{Binding Display}" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="#e0e0e0" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                                        <Button Content="✕" Tag="{Binding}" Click="BtnPresetRemoveStep_Click" Margin="4,0,0,0" Padding="4,0"
                                                Foreground="#a0a0b0" Cursor="Hand" FontSize="11"
                                                ToolTip="{Binding [Batch_Preset_RemoveStep], Source={x:Static services:LanguageManager.Instance}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#ff6b6b"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.35"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- 行列表 -->
        <DataGrid x:Name="dgItems" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                  Background="#161622" RowBackground="#1e1e2e" AlternatingRowBackground="#252538"
                  Foreground="#e0e0e0" HeadersVisibility="Column" BorderBrush="#3a3a5e" GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding [Batch_Col_Index], Source={x:Static services:LanguageManager.Instance}}" Binding="{Binding Index}" Width="50"/>
                <DataGridTextColumn Header="{Binding [Batch_Col_Prompt], Source={x:Static services:LanguageManager.Instance}}" Binding="{Binding Prompt}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Prompt}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{Binding [Batch_Col_FileName], Source={x:Static services:LanguageManager.Instance}}" Binding="{Binding FileName}" Width="130"/>
                <DataGridTextColumn Header="{Binding [Batch_Col_Platform], Source={x:Static services:LanguageManager.Instance}}" Binding="{Binding PlatformName}" Width="100"/>
                <DataGridTextColumn Header="{Binding [Batch_Col_Status], Source={x:Static services:LanguageManager.Instance}}" Binding="{Binding StatusText}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                    <Setter Property="Foreground" Value="#c4a7ff"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                    <Setter Property="Foreground" Value="#4ade80"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter Property="Foreground" Value="#ff6b6b"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                    <Setter Property="Foreground" Value="#a0a0b0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Invalid">
                                    <Setter Property="Foreground" Value="#f0a050"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{Binding [Batch_Col_Result], Source={x:Static services:LanguageManager.Instance}}" Binding="{Binding Message}" Width="240">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Message}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 进度 -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="progressBar" Height="8" VerticalAlignment="Center" Background="#2a2a3e" Foreground="#7c3aed" BorderThickness="0" Minimum="0" Maximum="1"/>
            <TextBlock x:Name="tbProgress" Grid.Column="1" Foreground="#e0e0e0" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <!-- 当前步骤 -->
        <TextBlock x:Name="tbStatus" Grid.Row="5" Foreground="#a0a0b0" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>

        <!-- 按钮 -->
        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnStart" Content="{Binding [Batch_Start], Source={x:Static services:LanguageManager.Instance}}" Click="BtnStart_Click"
                        MinWidth="80" Margin="0,0,8,0" Padding="10,5" Background="#7c3aed" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button x:Name="btnPause" Click="BtnPause_Click"
                        MinWidth="80" Margin="0,0,8,0" Padding="10,5" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0" Cursor="Hand"/>
                <Button x:Name="btnStop" Content="{Binding [Batch_Stop], Source={x:Static services:LanguageManager.Instance}}" Click="BtnStop_Click"
                        MinWidth="80" Margin="0,0,8,0" Padding="10,5" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0" Cursor="Hand"/>
                <Button x:Name="btnRetryFailed" Content="{Binding [Batch_RetryFailed], Source={x:Static services:LanguageManager.Instance}}" Click="BtnRetryFailed_Click"
                        MinWidth="80" Padding="10,5" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{Binding [Batch_OpenOutput], Source={x:Static services:LanguageManager.Instance}}" Click="BtnOpenOutput_Click"
                        Margin="0,0,8,0" Padding="10,5" Background="#2a2a3e" Foreground="#b0b0c0" BorderThickness="0" Cursor="Hand"/>
                <Button Content="{Binding [Batch_Settings], Source={x:Static services:LanguageManager.Instance}}" Click="BtnSettings_Click"
                        Margin="0,0,8,0" Padding="10,5" Background="#2a2a3e" Foreground="#b0b0c0" BorderThickness="0" Cursor="Hand"/>
                <Button Content="{Binding [Batch_Close], Source={x:Static services:LanguageManager.Instance}}" Click="BtnClose_Click"
                        MinWidth="70" Padding="10,5" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
