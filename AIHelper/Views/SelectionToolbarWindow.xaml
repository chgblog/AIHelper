<Window x:Class="AIHelper.Views.SelectionToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0">

    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#323154"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#6366F1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7C3AED"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#7C3AED"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Rectangle" x:Key="SeparatorStyle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="3,8"/>
            <Setter Property="Fill" Value="#383854"/>
        </Style>
    </Window.Resources>

    <Border Background="#F2171726" BorderBrush="#3E3E60" BorderThickness="1" CornerRadius="10" Margin="10" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.8" ScaleY="0.8" x:Name="WindowScale" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="16" ShadowDepth="4"/>
        </Border.Effect>
        <StackPanel x:Name="buttonPanel" Orientation="Horizontal" Margin="6,4"/>
    </Border>
</Window>
