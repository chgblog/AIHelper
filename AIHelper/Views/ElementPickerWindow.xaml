<Window x:Class="AIHelper.Views.ElementPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:AIHelper.Services"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding [ElementPicker_Title], Source={x:Static services:LanguageManager.Instance}}" Height="700" Width="1000" Icon="/icon.ico"
        WindowStartupLocation="CenterOwner" Background="#1a1a2e" Foreground="#e0e0e0"
        WindowStyle="SingleBorderWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Border Grid.Row="0" Background="#161622" Padding="12,8" BorderBrush="#3a3a5e" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Run Text="🎯" FontSize="16"/>
                    <Run x:Name="txtPickerMode" Text="{Binding [ElementPicker_Instruction], Source={x:Static services:LanguageManager.Instance}}" Foreground="#a0a0b0"/>
                </TextBlock>

                <TextBlock Grid.Column="1" x:Name="txtUrl" VerticalAlignment="Center" 
                           Foreground="#666680" FontSize="12" Margin="10,0"
                           TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="2" Content="{Binding [ElementPicker_Retry], Source={x:Static services:LanguageManager.Instance}}" Click="BtnRetry_Click" 
                        Width="80" Margin="0,0,8,0" Padding="5,3"/>
                <Button Grid.Column="3" Content="{Binding [Cancel], Source={x:Static services:LanguageManager.Instance}}" Click="BtnCancel_Click" 
                        Width="60" Padding="5,3"/>
            </Grid>
        </Border>

        <!-- WebView2 -->
        <wv2:WebView2 x:Name="pickerWebView" Grid.Row="1"/>

        <!-- Bottom status bar -->
        <Border Grid.Row="2" Background="#161622" Padding="12,6" BorderBrush="#3a3a5e" BorderThickness="0,1,0,0">
            <TextBlock x:Name="txtStatus" Text="{Binding [ElementPicker_Status_Loading], Source={x:Static services:LanguageManager.Instance}}" Foreground="#a0a0b0" FontSize="12"/>
        </Border>
    </Grid>
</Window>
