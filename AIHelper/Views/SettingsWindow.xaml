<Window x:Class="AIHelper.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:AIHelper.Services"
        Title="{Binding [Settings_Title], Source={x:Static services:LanguageManager.Instance}}" Height="500" Width="600" Icon="/icon.ico"
        WindowStartupLocation="CenterOwner" Background="#1a1a2e" Foreground="#e0e0e0"
        WindowStyle="ToolWindow">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="tabControl" Background="#161622" BorderBrush="#3a3a5e">
            <!-- 常规设置 -->
            <TabItem Header="{Binding [Settings_Tab_General], Source={x:Static services:LanguageManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="15">
                        <StackPanel>
                            <TextBlock Text="{Binding [Settings_General_Options], Source={x:Static services:LanguageManager.Instance}}" Margin="0,0,0,10" FontWeight="Bold" Foreground="#e0e0e0"/>
                            
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [Settings_General_Language], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="cmbLanguage" Grid.Column="1" Width="180" HorizontalAlignment="Left" Background="#1a1a2e" Foreground="#e0e0e0">
                                    <ComboBoxItem x:Name="cbiLangZh" Content="{Binding [Settings_General_Lang_ZH], Source={x:Static services:LanguageManager.Instance}}" Tag="zh"/>
                                    <ComboBoxItem x:Name="cbiLangEn" Content="{Binding [Settings_General_Lang_EN], Source={x:Static services:LanguageManager.Instance}}" Tag="en"/>
                                </ComboBox>
                            </Grid>

                            <CheckBox x:Name="chkShowMainWindow" Content="{Binding [Settings_General_ShowMainWindow], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" Margin="0,5,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{Binding [Settings_General_ShowMainWindowTip], Source={x:Static services:LanguageManager.Instance}}" Margin="20,5,0,15" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>

                            <CheckBox x:Name="chkAutoStart" Content="{Binding [Settings_General_AutoStart], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" Margin="0,5,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{Binding [Settings_General_AutoStartTip], Source={x:Static services:LanguageManager.Instance}}" Margin="20,5,0,15" Foreground="#a0a0b0" FontSize="12"/>

                            <CheckBox x:Name="chkAutoSubmit" Content="{Binding [Settings_General_AutoSubmit], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" Margin="0,5,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{Binding [Settings_General_AutoSubmitTip], Source={x:Static services:LanguageManager.Instance}}" Margin="20,5,0,15" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>

                            <CheckBox x:Name="chkEnableContextMenu" Content="{Binding [Settings_General_EnableContextMenu], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" Margin="0,5,0,0" VerticalContentAlignment="Center" Click="ChkEnableContextMenu_Click"/>
                            <TextBlock Text="{Binding [Settings_General_EnableContextMenuTip], Source={x:Static services:LanguageManager.Instance}}" Margin="20,5,0,0" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>

                            <Border Height="1" Background="#3a3a5e" Margin="0,15,0,15"/>

                            <TextBlock Text="{Binding [Settings_General_ProxySettings], Source={x:Static services:LanguageManager.Instance}}" Margin="0,0,0,10" FontWeight="Bold" Foreground="#e0e0e0"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [Settings_General_ProxyServer], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="txtProxyServer" Grid.Column="1" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" Padding="5,3"/>
                            </Grid>
                            <TextBlock Text="{Binding [Settings_General_ProxyTip], Source={x:Static services:LanguageManager.Instance}}" Margin="0,3,0,0" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 划词设置 -->
            <TabItem Header="{Binding [Settings_Tab_SelectionToolbar], Source={x:Static services:LanguageManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="15">
                        <StackPanel>
                            <TextBlock Text="{Binding [Settings_General_SelectionToolbar], Source={x:Static services:LanguageManager.Instance}}" Margin="0,0,0,10" FontWeight="Bold" Foreground="#e0e0e0"/>
                            <CheckBox x:Name="chkEnableSelectionToolbar" Content="{Binding [Settings_General_EnableSelectionToolbar], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" Margin="0,5,0,0" VerticalContentAlignment="Center" Click="ChkEnableSelectionToolbar_Click"/>
                            <TextBlock Text="{Binding [Settings_General_SelectionToolbarTip], Source={x:Static services:LanguageManager.Instance}}" Margin="20,5,0,10" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Margin="20,5,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="tbSelectionToolbarCopy" Text="{Binding [Settings_General_SelectionToolbarCopy], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="cmbSelectionToolbarCopy" Width="180" HorizontalAlignment="Left" Background="#1a1a2e" Foreground="#e0e0e0">
                                    <ComboBoxItem x:Name="cbiCopyDisabled" Content="{Binding [Settings_General_SelectionToolbarCopy_Disabled], Source={x:Static services:LanguageManager.Instance}}" Tag="0"/>
                                    <ComboBoxItem x:Name="cbiCopyFirst" Content="{Binding [Settings_General_SelectionToolbarCopy_First], Source={x:Static services:LanguageManager.Instance}}" Tag="1"/>
                                    <ComboBoxItem x:Name="cbiCopyLast" Content="{Binding [Settings_General_SelectionToolbarCopy_Last], Source={x:Static services:LanguageManager.Instance}}" Tag="2"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="20,10,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Settings_General_SelectionToolbarAutoHide], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="txtSelectionToolbarAutoHideSeconds" Width="60" Padding="5,3" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" VerticalAlignment="Center" TextChanged="TxtSelectionToolbarAutoHideSeconds_TextChanged"/>
                            </StackPanel>
                            <TextBlock x:Name="tbSelectionToolbarAutoHideTip" Margin="20,5,0,0" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>

                            <Border Height="1" Background="#3a3a5e" Margin="0,15,0,15"/>

                            <TextBlock Text="{Binding [Settings_Selection_AppScopeTitle], Source={x:Static services:LanguageManager.Instance}}" Margin="0,0,0,10" FontWeight="Bold" Foreground="#e0e0e0"/>
                            
                            <StackPanel Margin="0,0,0,10">
                                <RadioButton x:Name="rbScopeAll" GroupName="AppScopeGroup" Content="{Binding [Settings_Selection_AppScopeAll], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" Margin="0,3,0,3" Checked="RbScope_CheckedChanged"/>
                                <RadioButton x:Name="rbScopeInclude" GroupName="AppScopeGroup" Content="{Binding [Settings_Selection_AppScopeInclude], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" Margin="0,3,0,3" Checked="RbScope_CheckedChanged"/>
                                <RadioButton x:Name="rbScopeExclude" GroupName="AppScopeGroup" Content="{Binding [Settings_Selection_AppScopeExclude], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" Margin="0,3,0,3" Checked="RbScope_CheckedChanged"/>
                            </StackPanel>

                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding [Settings_Selection_AppScopeAppsTip], Source={x:Static services:LanguageManager.Instance}}" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button x:Name="btnSelectApps" Grid.Column="1" Content="{Binding [Settings_Selection_SelectApps], Source={x:Static services:LanguageManager.Instance}}" Click="BtnSelectApps_Click" Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBox x:Name="txtSelectionAppScopeApps" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" Padding="5" Margin="0,5,0,5"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 平台管理 -->
            <TabItem Header="{Binding [Settings_Tab_Platforms], Source={x:Static services:LanguageManager.Instance}}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <DataGrid x:Name="dgPlatforms" AutoGenerateColumns="False" CanUserAddRows="False" 
                               Background="#1a1a2e" RowBackground="#1e1e2e" AlternatingRowBackground="#252538"
                               Foreground="#e0e0e0" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [Settings_Platform_Name], Source={x:Static services:LanguageManager.Instance}}" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="{Binding [Settings_Platform_Url], Source={x:Static services:LanguageManager.Instance}}" Binding="{Binding Url}" Width="*"/>
                            <DataGridTemplateColumn Header="{Binding [Settings_Platform_Active], Source={x:Static services:LanguageManager.Instance}}" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <RadioButton IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     GroupName="PlatformActiveGroup" 
                                                     HorizontalAlignment="Center" 
                                                     VerticalAlignment="Center"
                                                     Click="RbPlatformActive_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{Binding [Settings_Platform_Proxy], Source={x:Static services:LanguageManager.Instance}}" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding UseProxy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding [Add], Source={x:Static services:LanguageManager.Instance}}" Click="BtnAddPlatform_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="{Binding [Edit], Source={x:Static services:LanguageManager.Instance}}" Click="BtnEditPlatform_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="{Binding [Delete], Source={x:Static services:LanguageManager.Instance}}" Click="BtnDeletePlatform_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="+ Claude" Click="BtnAddClaude_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="+ Gemini" Click="BtnAddGemini_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="+ DeepSeek" Click="BtnAddDeepSeek_Click" Width="80" Padding="5"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 操作管理 -->
            <TabItem Header="{Binding [Settings_Tab_Actions], Source={x:Static services:LanguageManager.Instance}}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <DataGrid x:Name="dgActions" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                Background="#1a1a2e" RowBackground="#1e1e2e" AlternatingRowBackground="#252538"
                                Foreground="#e0e0e0" HeadersVisibility="Column" SelectionChanged="DgActions_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [Settings_Action_SortOrder], Source={x:Static services:LanguageManager.Instance}}" Binding="{Binding SortOrder}" Width="50"/>
                            <DataGridTextColumn Header="{Binding [Settings_Action_Name], Source={x:Static services:LanguageManager.Instance}}" Binding="{Binding Name}" Width="100"/>
                            <DataGridTextColumn x:Name="colActionPlatform" Header="{Binding [Settings_Action_Platform], Source={x:Static services:LanguageManager.Instance}}" Binding="{Binding PlatformId}" Width="80"/>
                            <DataGridTextColumn Header="{Binding [Settings_Action_Prompt], Source={x:Static services:LanguageManager.Instance}}" Binding="{Binding Prompt}" Width="*"/>
                            <DataGridTemplateColumn Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="▲" Click="BtnRowMoveUp_Click" Width="26" Height="20" Margin="2,0" Padding="0" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0" ToolTip="{Binding [MoveUp], Source={x:Static services:LanguageManager.Instance}}"/>
                                            <Button Content="▼" Click="BtnRowMoveDown_Click" Width="26" Height="20" Margin="2,0" Padding="0" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0" ToolTip="{Binding [MoveDown], Source={x:Static services:LanguageManager.Instance}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding [Add], Source={x:Static services:LanguageManager.Instance}}" Click="BtnAddAction_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="{Binding [Edit], Source={x:Static services:LanguageManager.Instance}}" Click="BtnEditAction_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="{Binding [Delete], Source={x:Static services:LanguageManager.Instance}}" Click="BtnDeleteAction_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="{Binding [MoveUp], Source={x:Static services:LanguageManager.Instance}}" Click="BtnMoveUpAction_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="{Binding [MoveDown], Source={x:Static services:LanguageManager.Instance}}" Click="BtnMoveDownAction_Click" Width="80" Padding="5"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 其他设置 -->
            <TabItem Header="{Binding [Settings_Tab_Hotkeys], Source={x:Static services:LanguageManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="15">
                        <StackPanel>
                            <TextBlock Text="{Binding [Settings_Hotkey_PanelKey], Source={x:Static services:LanguageManager.Instance}}" Margin="0,0,0,10" FontWeight="Bold" Foreground="#e0e0e0"/>
                            <TextBox x:Name="txtPanelHotkey" Background="#1a1a2e" Foreground="#e0e0e0" Padding="10" 
                                      PreviewKeyDown="TxtPanelHotkey_PreviewKeyDown" IsReadOnly="True" BorderBrush="#3a3a5e"/>
                            <TextBlock Text="{Binding [Settings_Hotkey_Tip], Source={x:Static services:LanguageManager.Instance}}" Margin="0,5,0,0" Foreground="#a0a0b0" FontSize="12"/>
                            <TextBlock x:Name="tbPanelHotkeyConflict" Margin="0,4,0,0" Foreground="#ff6b6b" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap"/>

                            <TextBlock Text="{Binding [Settings_Hotkey_MainWindowKey], Source={x:Static services:LanguageManager.Instance}}" Margin="0,15,0,10" FontWeight="Bold" Foreground="#e0e0e0"/>
                            <TextBox x:Name="txtMainWindowHotkey" Background="#1a1a2e" Foreground="#e0e0e0" Padding="10"
                                      PreviewKeyDown="TxtMainWindowHotkey_PreviewKeyDown" IsReadOnly="True" BorderBrush="#3a3a5e"/>
                            <TextBlock Text="{Binding [Settings_Hotkey_Tip], Source={x:Static services:LanguageManager.Instance}}" Margin="0,5,0,0" Foreground="#a0a0b0" FontSize="12"/>
                            <TextBlock x:Name="tbMainWindowHotkeyConflict" Margin="0,4,0,0" Foreground="#ff6b6b" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap"/>

                            <Border Height="1" Background="#3a3a5e" Margin="0,15,0,15"/>

                            <TextBlock Text="{Binding [Settings_Other_ConfigManagement], Source={x:Static services:LanguageManager.Instance}}" Margin="0,0,0,10" FontWeight="Bold" Foreground="#e0e0e0"/>
                            <TextBlock Text="{Binding [Settings_Other_ConfigManagementTip], Source={x:Static services:LanguageManager.Instance}}" Margin="0,0,0,10" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="{Binding [Settings_Other_BackupConfig], Source={x:Static services:LanguageManager.Instance}}" Click="BtnBackupConfig_Click" Padding="12,6" Margin="0,0,10,0" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="{Binding [Settings_Other_RestoreConfig], Source={x:Static services:LanguageManager.Instance}}" Click="BtnRestoreConfig_Click" Padding="12,6" Margin="0,0,10,0" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="{Binding [Settings_Other_OpenConfigDir], Source={x:Static services:LanguageManager.Instance}}" Click="BtnOpenConfigDir_Click" Padding="12,6" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 模拟访问 -->
            <TabItem Header="{Binding [Settings_Tab_SimulateVisit], Source={x:Static services:LanguageManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="15">
                        <StackPanel>
                            <TextBlock Text="{Binding [Settings_Simulate_Title], Source={x:Static services:LanguageManager.Instance}}" Margin="0,0,0,10" FontWeight="Bold" Foreground="#e0e0e0"/>
                            <TextBlock Text="{Binding [Settings_Simulate_Desc], Source={x:Static services:LanguageManager.Instance}}" Margin="0,0,0,15" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>

                            <!-- 滚动间隔时长 -->
                            <Border Background="#1e1e2e" BorderBrush="#3a3a5e" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="{Binding [Settings_Simulate_IntervalSection], Source={x:Static services:LanguageManager.Instance}}" FontWeight="Bold" Foreground="#e0e0e0" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [Settings_Simulate_MinInterval], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="txtSimulateMinInterval" Grid.Column="1" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" Padding="5,3" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="~" Foreground="#a0a0b0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding [Settings_Simulate_MaxInterval], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="txtSimulateMaxInterval" Grid.Column="4" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" Padding="5,3" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding [Settings_Simulate_IntervalTip], Source={x:Static services:LanguageManager.Instance}}" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 滚动移动间距 -->
                            <Border Background="#1e1e2e" BorderBrush="#3a3a5e" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="{Binding [Settings_Simulate_DistanceSection], Source={x:Static services:LanguageManager.Instance}}" FontWeight="Bold" Foreground="#e0e0e0" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [Settings_Simulate_MinDistance], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="txtSimulateMinDistance" Grid.Column="1" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" Padding="5,3" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="~" Foreground="#a0a0b0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding [Settings_Simulate_MaxDistance], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="txtSimulateMaxDistance" Grid.Column="4" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" Padding="5,3" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding [Settings_Simulate_DistanceTip], Source={x:Static services:LanguageManager.Instance}}" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 网络代理设置 -->
                            <Border Background="#1e1e2e" BorderBrush="#3a3a5e" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="{Binding [Settings_Simulate_ProxySection], Source={x:Static services:LanguageManager.Instance}}" FontWeight="Bold" Foreground="#e0e0e0" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="chkSimulateUseProxy" Content="{Binding [Settings_Simulate_UseProxy], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="{Binding [Settings_Simulate_UseProxyTip], Source={x:Static services:LanguageManager.Instance}}" Foreground="#a0a0b0" FontSize="12" Margin="20,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 自动访问管理 -->
                            <Border Background="#1e1e2e" BorderBrush="#3a3a5e" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="{Binding [Settings_AutoVisit_Section], Source={x:Static services:LanguageManager.Instance}}" FontWeight="Bold" Foreground="#e0e0e0" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding [Settings_AutoVisit_SectionTip], Source={x:Static services:LanguageManager.Instance}}" Foreground="#a0a0b0" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                    <Button Content="{Binding [Settings_AutoVisit_ManageBtn], Source={x:Static services:LanguageManager.Instance}}" Click="BtnManageAutoVisit_Click" Width="150" HorizontalAlignment="Left" Padding="10,6" Background="#7c3aed" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 批量生图 -->
            <TabItem Header="{Binding [Settings_Tab_BatchImage], Source={x:Static services:LanguageManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="15">
                        <StackPanel>
                            <TextBlock Text="{Binding [Settings_Batch_Title], Source={x:Static services:LanguageManager.Instance}}" Margin="0,0,0,10" FontWeight="Bold" Foreground="#e0e0e0"/>
                            <TextBlock Text="{Binding [Settings_Batch_Desc], Source={x:Static services:LanguageManager.Instance}}" Margin="0,0,0,15" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>

                            <!-- 保存路径 -->
                            <Border Background="#1e1e2e" BorderBrush="#3a3a5e" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="{Binding [Settings_Batch_SavePathSection], Source={x:Static services:LanguageManager.Instance}}" FontWeight="Bold" Foreground="#e0e0e0" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtBatchSavePath" Grid.Column="0" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" Padding="5,3" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{Binding [Settings_Batch_Browse], Source={x:Static services:LanguageManager.Instance}}" Click="BtnBrowseBatchSavePath_Click"
                                                Margin="8,0,0,0" Padding="10,4" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0" Cursor="Hand"/>
                                        <Button Grid.Column="2" Content="{Binding [Settings_Batch_Open], Source={x:Static services:LanguageManager.Instance}}" Click="BtnOpenBatchSavePath_Click"
                                                Margin="8,0,0,0" Padding="10,4" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0" Cursor="Hand"/>
                                    </Grid>
                                    <TextBlock x:Name="tbBatchSavePathTip" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 运行参数 -->
                            <Border Background="#1e1e2e" BorderBrush="#3a3a5e" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="{Binding [Settings_Batch_RunSection], Source={x:Static services:LanguageManager.Instance}}" FontWeight="Bold" Foreground="#e0e0e0" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Settings_Batch_Timeout], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                        <TextBox x:Name="txtBatchTimeout" Grid.Row="0" Grid.Column="1" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" Padding="5,3" VerticalAlignment="Center" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [Settings_Batch_Retry], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                        <TextBox x:Name="txtBatchRetry" Grid.Row="1" Grid.Column="1" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" Padding="5,3" VerticalAlignment="Center" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [Settings_Batch_Interval], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="txtBatchMinInterval" Grid.Row="2" Grid.Column="1" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" Padding="5,3" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="~" Foreground="#a0a0b0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtBatchMaxInterval" Grid.Row="2" Grid.Column="3" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" Padding="5,3" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding [Settings_Batch_RunTip], Source={x:Static services:LanguageManager.Instance}}" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 更新 -->
            <TabItem Header="{Binding [Settings_Tab_About], Source={x:Static services:LanguageManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="15">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{Binding [Settings_About_Title], Source={x:Static services:LanguageManager.Instance}}" FontWeight="Bold" Foreground="#e0e0e0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="tbVersion" Text="v0.8.7" Foreground="#a0a0b0" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Border Background="#1e1e2e" BorderBrush="#3a3a5e" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 项目地址 -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [Settings_About_ProjectUrl], Source={x:Static services:LanguageManager.Instance}}" FontWeight="Bold" Foreground="#e0e0e0" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="tbProjectUrl" Text="https://github.com/chgblog/AIHelper" Foreground="#9d4edd" FontSize="13" TextWrapping="Wrap" Cursor="Hand" MouseDown="TbProjectUrl_MouseDown"/>
                                    </StackPanel>
                                    <Button x:Name="btnOpenProject" Content="{Binding [Settings_About_OpenProject], Source={x:Static services:LanguageManager.Instance}}" Grid.Row="0" Grid.Column="1" Click="BtnOpenProject_Click" Padding="12,6" Background="#7c3aed" Foreground="White" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>

                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="#3a3a5e" Margin="0,12,0,12"/>

                                    <!-- 更新地址 -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [Settings_About_UpdateUrl], Source={x:Static services:LanguageManager.Instance}}" FontWeight="Bold" Foreground="#e0e0e0" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="tbUpdateUrl" Text="https://github.com/chgblog/AIHelper/releases" Foreground="#9d4edd" FontSize="13" TextWrapping="Wrap" Cursor="Hand" MouseDown="TbUpdateUrl_MouseDown"/>
                                    </StackPanel>
                                    <Button x:Name="btnOpenUpdate" Content="{Binding [Settings_About_OpenUpdate], Source={x:Static services:LanguageManager.Instance}}" Grid.Row="2" Grid.Column="1" Click="BtnOpenUpdate_Click" Padding="12,6" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <CheckBox x:Name="chkAutoCheckUpdate" Content="{Binding [Settings_About_AutoCheckUpdate], Source={x:Static services:LanguageManager.Instance}}" IsChecked="True" Foreground="#e0e0e0" Margin="0,0,0,5" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{Binding [Settings_About_AutoCheckUpdateTip], Source={x:Static services:LanguageManager.Instance}}" Margin="20,0,0,15" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>

                            <TextBlock Text="{Binding [Settings_About_Tip], Source={x:Static services:LanguageManager.Instance}}" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{Binding [Save], Source={x:Static services:LanguageManager.Instance}}" Click="BtnSave_Click" Width="80" Margin="0,0,10,0" Padding="5" Background="#7c3aed" Foreground="White" BorderThickness="0"/>
            <Button Content="{Binding [Cancel], Source={x:Static services:LanguageManager.Instance}}" Click="BtnCancel_Click" Width="80" Padding="5" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
