<Window x:Class="AIHelper.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:AIHelper.Services"
        Title="{Binding [Settings_Title], Source={x:Static services:LanguageManager.Instance}}" Height="500" Width="600" Icon="/icon.ico"
        WindowStartupLocation="CenterOwner" Background="#1a1a2e" Foreground="#e0e0e0"
        WindowStyle="ToolWindow">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="tabControl" Background="#161622" BorderBrush="#3a3a5e">
            <!-- 常规设置 -->
            <TabItem Header="{Binding [Settings_Tab_General], Source={x:Static services:LanguageManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="15">
                        <StackPanel>
                            <TextBlock Text="{Binding [Settings_General_Options], Source={x:Static services:LanguageManager.Instance}}" Margin="0,0,0,10" FontWeight="Bold" Foreground="#e0e0e0"/>
                            
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [Settings_General_Language], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="cmbLanguage" Grid.Column="1" Width="180" HorizontalAlignment="Left" Background="#1a1a2e" Foreground="#e0e0e0">
                                    <ComboBoxItem x:Name="cbiLangZh" Content="{Binding [Settings_General_Lang_ZH], Source={x:Static services:LanguageManager.Instance}}" Tag="zh"/>
                                    <ComboBoxItem x:Name="cbiLangEn" Content="{Binding [Settings_General_Lang_EN], Source={x:Static services:LanguageManager.Instance}}" Tag="en"/>
                                </ComboBox>
                            </Grid>

                            <CheckBox x:Name="chkShowMainWindow" Content="{Binding [Settings_General_ShowMainWindow], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" Margin="0,5,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{Binding [Settings_General_ShowMainWindowTip], Source={x:Static services:LanguageManager.Instance}}" Margin="20,5,0,15" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>

                            <CheckBox x:Name="chkAutoStart" Content="{Binding [Settings_General_AutoStart], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" Margin="0,5,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{Binding [Settings_General_AutoStartTip], Source={x:Static services:LanguageManager.Instance}}" Margin="20,5,0,15" Foreground="#a0a0b0" FontSize="12"/>

                            <CheckBox x:Name="chkAutoSubmit" Content="{Binding [Settings_General_AutoSubmit], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" Margin="0,5,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{Binding [Settings_General_AutoSubmitTip], Source={x:Static services:LanguageManager.Instance}}" Margin="20,5,0,0" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>

                            <Border Height="1" Background="#3a3a5e" Margin="0,15,0,15"/>

                            <TextBlock Text="{Binding [Settings_General_ProxySettings], Source={x:Static services:LanguageManager.Instance}}" Margin="0,0,0,10" FontWeight="Bold" Foreground="#e0e0e0"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [Settings_General_ProxyServer], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="txtProxyServer" Grid.Column="1" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" Padding="5,3"/>
                            </Grid>
                            <TextBlock Text="{Binding [Settings_General_ProxyTip], Source={x:Static services:LanguageManager.Instance}}" Margin="0,3,0,0" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 划词设置 -->
            <TabItem Header="{Binding [Settings_Tab_SelectionToolbar], Source={x:Static services:LanguageManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="15">
                        <StackPanel>
                            <TextBlock Text="{Binding [Settings_General_SelectionToolbar], Source={x:Static services:LanguageManager.Instance}}" Margin="0,0,0,10" FontWeight="Bold" Foreground="#e0e0e0"/>
                            <CheckBox x:Name="chkEnableSelectionToolbar" Content="{Binding [Settings_General_EnableSelectionToolbar], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" Margin="0,5,0,0" VerticalContentAlignment="Center" Click="ChkEnableSelectionToolbar_Click"/>
                            <TextBlock Text="{Binding [Settings_General_SelectionToolbarTip], Source={x:Static services:LanguageManager.Instance}}" Margin="20,5,0,10" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>

                            <CheckBox x:Name="chkEnableClipboardEnhancementToolbar" Content="{Binding [Settings_General_EnableClipboardEnhancementToolbar], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" Margin="20,5,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{Binding [Settings_General_ClipboardEnhancementToolbarTip], Source={x:Static services:LanguageManager.Instance}}" Margin="40,5,0,0" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Margin="20,10,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Settings_General_SelectionToolbarAutoHide], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="txtSelectionToolbarAutoHideSeconds" Width="60" Padding="5,3" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" VerticalAlignment="Center" TextChanged="TxtSelectionToolbarAutoHideSeconds_TextChanged"/>
                            </StackPanel>
                            <TextBlock x:Name="tbSelectionToolbarAutoHideTip" Margin="20,5,0,0" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>

                            <Border Height="1" Background="#3a3a5e" Margin="0,15,0,15"/>

                            <TextBlock Text="{Binding [Settings_Selection_AppScopeTitle], Source={x:Static services:LanguageManager.Instance}}" Margin="0,0,0,10" FontWeight="Bold" Foreground="#e0e0e0"/>
                            
                            <StackPanel Margin="0,0,0,10">
                                <RadioButton x:Name="rbScopeAll" GroupName="AppScopeGroup" Content="{Binding [Settings_Selection_AppScopeAll], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" Margin="0,3,0,3" Checked="RbScope_CheckedChanged"/>
                                <RadioButton x:Name="rbScopeInclude" GroupName="AppScopeGroup" Content="{Binding [Settings_Selection_AppScopeInclude], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" Margin="0,3,0,3" Checked="RbScope_CheckedChanged"/>
                                <RadioButton x:Name="rbScopeExclude" GroupName="AppScopeGroup" Content="{Binding [Settings_Selection_AppScopeExclude], Source={x:Static services:LanguageManager.Instance}}" Foreground="#e0e0e0" Margin="0,3,0,3" Checked="RbScope_CheckedChanged"/>
                            </StackPanel>

                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding [Settings_Selection_AppScopeAppsTip], Source={x:Static services:LanguageManager.Instance}}" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button x:Name="btnSelectApps" Grid.Column="1" Content="{Binding [Settings_Selection_SelectApps], Source={x:Static services:LanguageManager.Instance}}" Click="BtnSelectApps_Click" Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBox x:Name="txtSelectionAppScopeApps" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" Padding="5" Margin="0,5,0,5"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 平台管理 -->
            <TabItem Header="{Binding [Settings_Tab_Platforms], Source={x:Static services:LanguageManager.Instance}}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <DataGrid x:Name="dgPlatforms" AutoGenerateColumns="False" CanUserAddRows="False" 
                               Background="#1a1a2e" RowBackground="#1e1e2e" AlternatingRowBackground="#252538"
                               Foreground="#e0e0e0" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [Settings_Platform_Name], Source={x:Static services:LanguageManager.Instance}}" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="{Binding [Settings_Platform_Url], Source={x:Static services:LanguageManager.Instance}}" Binding="{Binding Url}" Width="*"/>
                            <DataGridTemplateColumn Header="{Binding [Settings_Platform_Active], Source={x:Static services:LanguageManager.Instance}}" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <RadioButton IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     GroupName="PlatformActiveGroup" 
                                                     HorizontalAlignment="Center" 
                                                     VerticalAlignment="Center"
                                                     Click="RbPlatformActive_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding [Add], Source={x:Static services:LanguageManager.Instance}}" Click="BtnAddPlatform_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="{Binding [Edit], Source={x:Static services:LanguageManager.Instance}}" Click="BtnEditPlatform_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="{Binding [Delete], Source={x:Static services:LanguageManager.Instance}}" Click="BtnDeletePlatform_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="+ Claude" Click="BtnAddClaude_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="+ Gemini" Click="BtnAddGemini_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="+ DeepSeek" Click="BtnAddDeepSeek_Click" Width="80" Padding="5"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 操作管理 -->
            <TabItem Header="{Binding [Settings_Tab_Actions], Source={x:Static services:LanguageManager.Instance}}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <DataGrid x:Name="dgActions" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                Background="#1a1a2e" RowBackground="#1e1e2e" AlternatingRowBackground="#252538"
                                Foreground="#e0e0e0" HeadersVisibility="Column" SelectionChanged="DgActions_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [Settings_Action_SortOrder], Source={x:Static services:LanguageManager.Instance}}" Binding="{Binding SortOrder}" Width="50"/>
                            <DataGridTextColumn Header="{Binding [Settings_Action_Name], Source={x:Static services:LanguageManager.Instance}}" Binding="{Binding Name}" Width="100"/>
                            <DataGridTextColumn Header="{Binding [Settings_Action_Prompt], Source={x:Static services:LanguageManager.Instance}}" Binding="{Binding Prompt}" Width="*"/>
                            <DataGridTemplateColumn Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="▲" Click="BtnRowMoveUp_Click" Width="26" Height="20" Margin="2,0" Padding="0" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0" ToolTip="{Binding [MoveUp], Source={x:Static services:LanguageManager.Instance}}"/>
                                            <Button Content="▼" Click="BtnRowMoveDown_Click" Width="26" Height="20" Margin="2,0" Padding="0" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0" ToolTip="{Binding [MoveDown], Source={x:Static services:LanguageManager.Instance}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding [Add], Source={x:Static services:LanguageManager.Instance}}" Click="BtnAddAction_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="{Binding [Edit], Source={x:Static services:LanguageManager.Instance}}" Click="BtnEditAction_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="{Binding [Delete], Source={x:Static services:LanguageManager.Instance}}" Click="BtnDeleteAction_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="{Binding [MoveUp], Source={x:Static services:LanguageManager.Instance}}" Click="BtnMoveUpAction_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="{Binding [MoveDown], Source={x:Static services:LanguageManager.Instance}}" Click="BtnMoveDownAction_Click" Width="80" Padding="5"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 快捷键设置 -->
            <TabItem Header="{Binding [Settings_Tab_Hotkeys], Source={x:Static services:LanguageManager.Instance}}">
                <Grid Margin="10">
                    <StackPanel>
                        <TextBlock Text="{Binding [Settings_Hotkey_PanelKey], Source={x:Static services:LanguageManager.Instance}}" Margin="0,0,0,10" FontWeight="Bold"/>
                        <TextBox x:Name="txtPanelHotkey" Background="#1a1a2e" Foreground="#e0e0e0" Padding="10" 
                                  PreviewKeyDown="TxtPanelHotkey_PreviewKeyDown" IsReadOnly="True"/>
                        <TextBlock Text="{Binding [Settings_Hotkey_Tip], Source={x:Static services:LanguageManager.Instance}}" Margin="0,5,0,0" Foreground="#a0a0b0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 项目与更新 -->
            <TabItem Header="{Binding [Settings_Tab_About], Source={x:Static services:LanguageManager.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="15">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{Binding [Settings_About_Title], Source={x:Static services:LanguageManager.Instance}}" FontWeight="Bold" Foreground="#e0e0e0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="tbVersion" Text="v0.5.9.2" Foreground="#a0a0b0" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Border Background="#1e1e2e" BorderBrush="#3a3a5e" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 项目地址 -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [Settings_About_ProjectUrl], Source={x:Static services:LanguageManager.Instance}}" FontWeight="Bold" Foreground="#e0e0e0" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="tbProjectUrl" Text="https://github.com/chgblog/AIHelper" Foreground="#9d4edd" FontSize="13" TextWrapping="Wrap" Cursor="Hand" MouseDown="TbProjectUrl_MouseDown"/>
                                    </StackPanel>
                                    <Button x:Name="btnOpenProject" Content="{Binding [Settings_About_OpenProject], Source={x:Static services:LanguageManager.Instance}}" Grid.Row="0" Grid.Column="1" Click="BtnOpenProject_Click" Padding="12,6" Background="#7c3aed" Foreground="White" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>

                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="#3a3a5e" Margin="0,12,0,12"/>

                                    <!-- 更新地址 -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [Settings_About_UpdateUrl], Source={x:Static services:LanguageManager.Instance}}" FontWeight="Bold" Foreground="#e0e0e0" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="tbUpdateUrl" Text="https://github.com/chgblog/AIHelper/releases" Foreground="#9d4edd" FontSize="13" TextWrapping="Wrap" Cursor="Hand" MouseDown="TbUpdateUrl_MouseDown"/>
                                    </StackPanel>
                                    <Button x:Name="btnOpenUpdate" Content="{Binding [Settings_About_OpenUpdate], Source={x:Static services:LanguageManager.Instance}}" Grid.Row="2" Grid.Column="1" Click="BtnOpenUpdate_Click" Padding="12,6" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding [Settings_About_Tip], Source={x:Static services:LanguageManager.Instance}}" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{Binding [Save], Source={x:Static services:LanguageManager.Instance}}" Click="BtnSave_Click" Width="80" Margin="0,0,10,0" Padding="5" Background="#7c3aed" Foreground="White" BorderThickness="0"/>
            <Button Content="{Binding [Cancel], Source={x:Static services:LanguageManager.Instance}}" Click="BtnCancel_Click" Width="80" Padding="5" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
