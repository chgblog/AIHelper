<Window x:Class="AIHelper.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="500" Width="600" Icon="/icon.ico"
        WindowStartupLocation="CenterOwner" Background="#1a1a2e" Foreground="#e0e0e0"
        WindowStyle="ToolWindow">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Background="#161622" BorderBrush="#3a3a5e">
            <!-- 常规设置 -->
            <TabItem Header="常规设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="15">
                        <StackPanel>
                            <TextBlock Text="常规选项" Margin="0,0,0,10" FontWeight="Bold" Foreground="#e0e0e0"/>
                            <CheckBox x:Name="chkAutoStart" Content="开机自动启动 AIHelper" Foreground="#e0e0e0" Margin="0,5,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Text="勾选后，Windows 登录时将自动在后台运行 AIHelper" Margin="20,5,0,15" Foreground="#a0a0b0" FontSize="12"/>

                            <CheckBox x:Name="chkAutoSubmit" Content="自动提交提示词" Foreground="#e0e0e0" Margin="0,5,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Text="勾选后注入提示词后自动点击发送；未勾选时仅点击新会话并注入提示词，不点击发送按钮" Margin="20,5,0,0" Foreground="#a0a0b0" FontSize="12"/>

                            <Border Height="1" Background="#3a3a5e" Margin="0,15,0,15"/>

                            <TextBlock Text="网络代理设置" Margin="0,0,0,10" FontWeight="Bold" Foreground="#e0e0e0"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="代理服务器:" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="txtProxyServer" Grid.Column="1" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" Padding="5,3"/>
                            </Grid>
                            <TextBlock Text="例如: http://127.0.0.1:7890 或 socks5://127.0.0.1:1080。留空则自动使用 Windows 系统代理" Margin="0,3,0,0" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 平台管理 -->
            <TabItem Header="平台管理">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <DataGrid x:Name="dgPlatforms" AutoGenerateColumns="False" CanUserAddRows="False" 
                              Background="#1a1a2e" RowBackground="#1e1e2e" AlternatingRowBackground="#252538"
                              Foreground="#e0e0e0" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*"/>
                            <DataGridTemplateColumn Header="激活" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <RadioButton IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     GroupName="PlatformActiveGroup" 
                                                     HorizontalAlignment="Center" 
                                                     VerticalAlignment="Center"
                                                     Click="RbPlatformActive_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="添加" Click="BtnAddPlatform_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="编辑" Click="BtnEditPlatform_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="删除" Click="BtnDeletePlatform_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="+ Claude" Click="BtnAddClaude_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="+ Gemini" Click="BtnAddGemini_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="+ DeepSeek" Click="BtnAddDeepSeek_Click" Width="80" Padding="5"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 操作管理 -->
            <TabItem Header="操作管理">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <DataGrid x:Name="dgActions" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="#1a1a2e" RowBackground="#1e1e2e" AlternatingRowBackground="#252538"
                              Foreground="#e0e0e0" HeadersVisibility="Column" SelectionChanged="DgActions_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="100"/>
                            <DataGridTextColumn Header="提示词" Binding="{Binding Prompt}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                        <Button Content="添加" Click="BtnAddAction_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="删除" Click="BtnDeleteAction_Click" Width="80" Padding="5"/>
                    </StackPanel>
                    
                    <Grid Grid.Row="2" Background="#252538" Margin="0,5,0,0" x:Name="actionEditPanel" IsEnabled="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="名称:" Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtActionName" Grid.Row="0" Grid.Column="1" Margin="5" Background="#1a1a2e" Foreground="#e0e0e0"/>
                        
                        <TextBlock Text="快捷键:" Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtActionHotkey" Grid.Row="1" Grid.Column="1" Margin="5" Background="#1a1a2e" Foreground="#e0e0e0" 
                                 PreviewKeyDown="TxtActionHotkey_PreviewKeyDown" IsReadOnly="True"/>
                                 
                        <TextBlock Text="提示词:" Grid.Row="2" Grid.Column="0" Margin="5" VerticalAlignment="Top"/>
                        <TextBox x:Name="txtActionPrompt" Grid.Row="2" Grid.Column="1" Margin="5" Background="#1a1a2e" Foreground="#e0e0e0"
                                 AcceptsReturn="True" MinLines="3" MaxLines="3" TextWrapping="Wrap"/>
                                 
                        <Button Content="应用修改" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Margin="5" 
                                Width="100" Padding="5" Click="BtnApplyActionEdit_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 快捷键设置 -->
            <TabItem Header="快捷键设置">
                <Grid Margin="10">
                    <StackPanel>
                        <TextBlock Text="面板唤醒快捷键:" Margin="0,0,0,10" FontWeight="Bold"/>
                        <TextBox x:Name="txtPanelHotkey" Background="#1a1a2e" Foreground="#e0e0e0" Padding="10" 
                                 PreviewKeyDown="TxtPanelHotkey_PreviewKeyDown" IsReadOnly="True"/>
                        <TextBlock Text="请点击输入框并按下快捷键组合" Margin="0,5,0,0" Foreground="#a0a0b0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 项目与更新 -->
            <TabItem Header="项目与更新">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="15">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="项目与更新信息" FontWeight="Bold" Foreground="#e0e0e0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="tbVersion" Text="v0.3.8" Foreground="#a0a0b0" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Border Background="#1e1e2e" BorderBrush="#3a3a5e" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 项目地址 -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="项目地址" FontWeight="Bold" Foreground="#e0e0e0" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="tbProjectUrl" Text="https://github.com/chgblog/AIHelper" Foreground="#9d4edd" FontSize="13" TextWrapping="Wrap" Cursor="Hand" MouseDown="TbProjectUrl_MouseDown"/>
                                    </StackPanel>
                                    <Button x:Name="btnOpenProject" Content="进入项目主页" Grid.Row="0" Grid.Column="1" Click="BtnOpenProject_Click" Padding="12,6" Background="#7c3aed" Foreground="White" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>

                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="#3a3a5e" Margin="0,12,0,12"/>

                                    <!-- 更新地址 -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="更新地址" FontWeight="Bold" Foreground="#e0e0e0" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="tbUpdateUrl" Text="https://github.com/chgblog/AIHelper/releases" Foreground="#9d4edd" FontSize="13" TextWrapping="Wrap" Cursor="Hand" MouseDown="TbUpdateUrl_MouseDown"/>
                                    </StackPanel>
                                    <Button x:Name="btnOpenUpdate" Content="进入 Release 列表" Grid.Row="2" Grid.Column="1" Click="BtnOpenUpdate_Click" Padding="12,6" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="提示：点击地址链接或按钮即可在默认浏览器中打开对应页面。" Foreground="#a0a0b0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存" Click="BtnSave_Click" Width="80" Margin="0,0,10,0" Padding="5" Background="#7c3aed" Foreground="White" BorderThickness="0"/>
            <Button Content="取消" Click="BtnCancel_Click" Width="80" Padding="5" Background="#3a3a5e" Foreground="#e0e0e0" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
