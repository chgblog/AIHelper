<Window x:Class="AIHelper.Views.AppSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:AIHelper.Services"
        mc:Ignorable="d"
        Title="{Binding [AppSelection_Title], Source={x:Static services:LanguageManager.Instance}}" 
        Height="620" Width="560" MinHeight="450" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e2e" Foreground="#e0e0e0" ShowInTaskbar="False">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2d2d44"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#3a3a5e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3d3d5c"/>
                                <Setter Property="BorderBrush" Value="#5a5a8e"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#252538"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部搜索栏与过滤开关 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearch" Grid.Column="0" 
                         Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a3a5e" 
                         Padding="8,6" Margin="0,0,10,0" FontSize="13" VerticalContentAlignment="Center"
                         TextChanged="TxtSearch_TextChanged"/>
                <Button x:Name="btnRefresh" Grid.Column="1" 
                        Content="{Binding [AppSelection_Refresh], Source={x:Static services:LanguageManager.Instance}}" 
                        Click="BtnRefresh_Click" Width="75"/>
            </Grid>

            <CheckBox x:Name="chkOnlyWindowApps" Grid.Row="1" 
                      Content="{Binding [AppSelection_OnlyWindowApps], Source={x:Static services:LanguageManager.Instance}}" 
                      IsChecked="True" Foreground="#b0b0c8" FontSize="12" VerticalContentAlignment="Center"
                      Click="ChkOnlyWindowApps_Click"/>
        </Grid>

        <!-- 应用列表 -->
        <Border Grid.Row="1" Background="#1a1a2e" BorderBrush="#3a3a5e" BorderThickness="1" CornerRadius="4">
            <Grid>
                <ListView x:Name="lvApps" Background="Transparent" BorderThickness="0" Foreground="#e0e0e0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionMode="Multiple" MouseDoubleClick="LvApps_MouseDoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="2,1"/>
                            <Setter Property="Padding" Value="6,6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                                BorderBrush="#252538" BorderThickness="0,0,0,1" 
                                                Padding="{TemplateBinding Padding}" CornerRadius="3">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#28283f"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#32324e"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <Border Grid.Column="1" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppName}" FontWeight="Bold" Foreground="#ffffff" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Border Background="#2a2a40" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding ProcessName}" Foreground="#89b4fa" FontFamily="Consolas, Segoe UI" FontSize="11"/>
                                        </Border>
                                        <TextBlock Text="{Binding MainWindowTitle}" Foreground="#9499b8" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="300" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 空状态提示 -->
                <TextBlock x:Name="tbEmptyHint" 
                           Text="{Binding [AppSelection_NoAppsFound], Source={x:Static services:LanguageManager.Instance}}" 
                           Foreground="#8080a0" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- 选择快捷控制与数量提示 -->
        <Grid Grid.Row="2" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="{Binding [AppSelection_SelectAll], Source={x:Static services:LanguageManager.Instance}}" 
                        Click="BtnSelectAll_Click" Margin="0,0,5,0" Padding="8,3" FontSize="12"/>
                <Button Content="{Binding [AppSelection_InvertSelect], Source={x:Static services:LanguageManager.Instance}}" 
                        Click="BtnInvertSelect_Click" Margin="0,0,5,0" Padding="8,3" FontSize="12"/>
                <Button Content="{Binding [AppSelection_ClearSelect], Source={x:Static services:LanguageManager.Instance}}" 
                        Click="BtnClearSelect_Click" Padding="8,3" FontSize="12"/>
            </StackPanel>

            <TextBlock x:Name="tbSelectedCount" Grid.Column="1" 
                       HorizontalAlignment="Right" VerticalAlignment="Center" 
                       Foreground="#a0a0c0" FontSize="12"/>
        </Grid>

        <!-- 底部确定/取消按钮 -->
        <Border Grid.Row="3" BorderBrush="#3a3a5e" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnAppend" 
                        Content="{Binding [AppSelection_Append], Source={x:Static services:LanguageManager.Instance}}" 
                        Click="BtnAppend_Click" Margin="0,0,8,0" Padding="14,6" Background="#3b4261" BorderBrush="#585b70" FontWeight="SemiBold"/>
                <Button x:Name="btnReplace" 
                        Content="{Binding [AppSelection_Replace], Source={x:Static services:LanguageManager.Instance}}" 
                        Click="BtnReplace_Click" Margin="0,0,8,0" Padding="14,6" Background="#45475a" BorderBrush="#585b70"/>
                <Button Content="{Binding [Cancel], Source={x:Static services:LanguageManager.Instance}}" 
                        Click="BtnCancel_Click" Padding="14,6"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
